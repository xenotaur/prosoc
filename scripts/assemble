#!/usr/bin/env bash
# Assemble a normative guidance packet from a manifest.
#
# Loads the member cards named in the manifest, schema-validates each, applies
# the fail-closed lifecycle gate, and composes them into a namespaced,
# in-toto-style provenance envelope printed to stdout. Fail-closed: if any
# member is below the gate threshold, nothing is emitted and the reason is
# printed to stderr.
#
# Usage:
#   scripts/assemble <manifest.yml>
#   scripts/assemble <manifest.yml> --allow-unapproved "why this dev packet"
#   scripts/assemble <manifest.yml> --format json
#   scripts/assemble <manifest.yml> --allow-unapproved "..." --check
#
# Example:
#   scripts/assemble src/prosoc/manifests/sample_packet/manifest.yml \
#     --allow-unapproved "local test on the pre-APPROVED corpus"

set -euo pipefail

python -m prosoc.nca.packet.cli "$@"
